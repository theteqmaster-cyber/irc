APP_NAME="IRC Zimbabwe - Local AI Workspace v1.1.1.2"
APP_ENV=development
APP_DEBUG=true
APP_PORT=18765
APP_URL=http://localhost:18765

# Groq API Configuration (Lightning-Fast Llama 3.3 70B)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Firebase Database Credentials
FIREBASE_PROJECT_ID=irc-zim-study-ai
FIREBASE_API_KEY=your-firebase-api-key

# Paynow Zimbabwe Payment Credentials
PAYNOW_INTEGRATION_ID=your-paynow-id
PAYNOW_INTEGRATION_KEY=your-paynow-key
PAYNOW_RESULT_URL=http://localhost:18765/api/payments/webhook
PAYNOW_RETURN_URL=http://localhost:18765/
